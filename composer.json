{
  "name": "aavirbhava/module-ai-shopping-assistant",
  "description": "Store-grounded conversational product search and shopping assistance for Magento 2.",
  "type": "magento2-module",
  "license": "proprietary",
  "require": {
    "php": ">=8.2 <8.6",
    "magento/framework": ">=103.0.7 <104.0",
    "magento/module-catalog": ">=104.0 <105.0",
    "magento/module-indexer": ">=100.4 <101.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Aavirbhava\\AiShoppingAssistant\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aavirbhava\\AiShoppingAssistant\\Test\\": "Test/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": true,
      "magento/magento-composer-installer": true
    }
  },
  "scripts": {
    "lint": "find Api Model Test -name '*.php' -print0 | xargs -0 -n1 php -l",
    "validate-structure": "python3 tools/validate_structure.py",
    "test": "phpunit -c phpunit.xml.dist"
  }
}
