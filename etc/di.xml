<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Config\ConfigurationReaderInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Config\ConfigurationReader"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Config\SecretReaderInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Config\SecretReader"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Provider\LlmProviderRegistryInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Provider\LlmProviderRegistry"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Provider\EmbeddingProviderRegistryInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Provider\EmbeddingProviderRegistry"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Provider\ConfiguredProviderResolverInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Provider\ConfiguredProviderResolver"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Provider\FallbackEligibilityPolicyInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Provider\FallbackEligibilityPolicy"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Provider\ProviderLabelRegistryInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Provider\ProviderLabelRegistry"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Catalog\ProductIndexEligibilityPolicyInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\ProductIndexEligibilityPolicy"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Catalog\UntrustedContentSanitizerInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\UntrustedContentSanitizer"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Catalog\ProductAttributePolicyInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\ProductAttributePolicy"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Catalog\ProductDocumentNormalizerInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\ProductDocumentNormalizer"/>
    <preference for="Aavirbhava\AiShoppingAssistant\Api\Catalog\ContentHashServiceInterface"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\ContentHashService"/>

    <type name="Aavirbhava\AiShoppingAssistant\Model\Provider\LlmProviderRegistry">
        <arguments>
            <argument name="providers" xsi:type="array"/>
        </arguments>
    </type>
    <type name="Aavirbhava\AiShoppingAssistant\Model\Provider\EmbeddingProviderRegistry">
        <arguments>
            <argument name="providers" xsi:type="array"/>
        </arguments>
    </type>
    <type name="Aavirbhava\AiShoppingAssistant\Model\Provider\ProviderLabelRegistry">
        <arguments>
            <argument name="labels" xsi:type="array">
                <item name="openai" xsi:type="string">OpenAI</item>
                <item name="anthropic" xsi:type="string">Anthropic Claude</item>
                <item name="xai" xsi:type="string">xAI Grok</item>
                <item name="openai_compatible" xsi:type="string">Local / OpenAI-Compatible</item>
                <item name="voyage" xsi:type="string">Voyage AI</item>
            </argument>
        </arguments>
    </type>
</config>
