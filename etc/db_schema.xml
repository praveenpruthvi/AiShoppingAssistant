<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="aavirbhava_ai_incremental_product_work" resource="default" engine="innodb"
           comment="AI Shopping Assistant Incremental Product Work">
        <column xsi:type="int" name="work_id" unsigned="true" nullable="false" identity="true"
                comment="Work ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" identity="false"
                comment="Product Entity ID"/>
        <column xsi:type="int" name="generation" unsigned="true" nullable="false" identity="false"
                default="1" comment="Latest Requested Work Generation"/>
        <column xsi:type="int" name="claimed_generation" unsigned="true" nullable="true" identity="false"
                comment="Processing Lease Generation"/>
        <column xsi:type="varchar" name="state" nullable="false" length="20" default="pending"
                comment="Work State"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" identity="false"
                default="0" comment="Attempt Count"/>
        <column xsi:type="datetime" name="next_attempt_at" on_update="false" nullable="false"
                comment="Next Attempt At"/>
        <column xsi:type="varchar" name="lease_token" nullable="true" length="64"
                comment="Opaque Lease Token"/>
        <column xsi:type="datetime" name="lease_expires_at" on_update="false" nullable="true"
                comment="Lease Expires At"/>
        <column xsi:type="varchar" name="last_error_code" nullable="true" length="64"
                comment="Last Sanitized Error Code"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="work_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="AAVIRBHAVA_AI_INCREMENTAL_PRODUCT_WORK_PRODUCT_ID">
            <column name="product_id"/>
        </constraint>
        <index referenceId="AAVIRBHAVA_AI_INCREMENTAL_PRODUCT_WORK_DUE" indexType="btree">
            <column name="state"/>
            <column name="next_attempt_at"/>
            <column name="product_id"/>
        </index>
        <index referenceId="AAVIRBHAVA_AI_INCREMENTAL_PRODUCT_WORK_LEASE" indexType="btree">
            <column name="state"/>
            <column name="lease_expires_at"/>
        </index>
    </table>
    <table name="aavirbhava_ai_rebuild_fence" resource="default" engine="innodb"
           comment="AI Shopping Assistant Full Rebuild Fence">
        <column xsi:type="smallint" name="fence_id" unsigned="true" nullable="false" identity="false"
                comment="Singleton Fence ID"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false"
                default="0" comment="Fence Active"/>
        <column xsi:type="varchar" name="owner_token" nullable="true" length="64"
                comment="Opaque Owner Token"/>
        <column xsi:type="datetime" name="lease_expires_at" on_update="false" nullable="true"
                comment="Lease Expires At"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="fence_id"/>
        </constraint>
        <index referenceId="AAVIRBHAVA_AI_REBUILD_FENCE_ACTIVE" indexType="btree">
            <column name="is_active"/>
            <column name="lease_expires_at"/>
        </index>
    </table>
    <table name="aavirbhava_ai_incremental_reconciliation" resource="default" engine="innodb"
           comment="AI Shopping Assistant Incremental Reconciliation Cursor">
        <column xsi:type="smallint" name="cursor_id" unsigned="true" nullable="false" identity="false"
                comment="Singleton Cursor ID"/>
        <column xsi:type="int" name="last_product_id" unsigned="true" nullable="false" identity="false"
                default="0" comment="Last Scheduled Product Entity ID"/>
        <column xsi:type="datetime" name="pass_started_at" on_update="false" nullable="true"
                comment="Pass Started At"/>
        <column xsi:type="datetime" name="completed_at" on_update="false" nullable="true"
                comment="Completed At"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cursor_id"/>
        </constraint>
    </table>
    <table name="aavirbhava_ai_conversation_message" resource="default" engine="innodb"
           comment="AI Shopping Assistant Conversation History Message">
        <column xsi:type="bigint" name="message_id" unsigned="true" nullable="false" identity="true"
                comment="Message ID"/>
        <column xsi:type="varchar" name="conversation_id" nullable="false" length="64"
                comment="Opaque Conversation ID (session-scoped, never a customer/order identifier)"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" identity="false"
                comment="Store View ID"/>
        <column xsi:type="varchar" name="role" nullable="false" length="20"
                comment="Message Role (user, assistant, tool)"/>
        <column xsi:type="mediumtext" name="content" nullable="false"
                comment="Message Content"/>
        <column xsi:type="varchar" name="tool_call_id" nullable="true" length="64"
                comment="Tool Call ID (tool-role messages only)"/>
        <column xsi:type="mediumtext" name="tool_calls" nullable="true"
                comment="JSON-Encoded Tool Calls (assistant-role messages only)"/>
        <column xsi:type="mediumtext" name="response_payload" nullable="true"
                comment="JSON-Encoded Products/Follow-Up-Questions/Actions (final assistant message of a turn only) — the same shape ChatResponseSerializer sends a live turn, persisted so a restored turn can render identical product cards"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="message_id"/>
        </constraint>
        <index referenceId="AAVIRBHAVA_AI_CONVERSATION_MESSAGE_LOOKUP" indexType="btree">
            <column name="conversation_id"/>
            <column name="store_id"/>
            <column name="message_id"/>
        </index>
        <index referenceId="AAVIRBHAVA_AI_CONVERSATION_MESSAGE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
