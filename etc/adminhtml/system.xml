<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="aavirbhava" translate="label" sortOrder="910">
            <label>Aavirbhava</label>
        </tab>
        <section id="ai_shopping_assistant" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Shopping Assistant</label>
            <tab>aavirbhava</tab>
            <resource>Aavirbhava_AiShoppingAssistant::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Assistant</label>
                    <comment>Disabled by default until providers, retrieval, and guardrails have been tested.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="strict_store_only" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Strict Store-Only Mode</label>
                    <comment>Reject requests unrelated to this store's products, services, and approved content.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="max_conversation_messages" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Conversation History Messages</label>
                    <comment>How many prior messages of a conversation (not customer-visible turns — a single turn can span several messages via tool calls) are kept and re-sent as context on each new message.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="appearance" translate="label" type="text" sortOrder="15"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Appearance</label>
                <field id="primary_color" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Window/Header Color</label>
                    <comment>Color for the widget's header bar and floating toggle button. Leave blank to use the default blue; the header text color is always chosen automatically to stay readable against whatever color is set here.</comment>
                    <frontend_model>Aavirbhava\AiShoppingAssistant\Block\Adminhtml\System\Config\ColorPickerField</frontend_model>
                </field>
                <field id="message_bubble_color" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Message Bubble Background Color</label>
                    <comment>Color for the assistant's chat bubbles. Leave both this and Message Bubble Text Color blank to use the default; set only one and the other is chosen automatically to stay readable against it; set both to use your own pairing exactly as entered.</comment>
                    <frontend_model>Aavirbhava\AiShoppingAssistant\Block\Adminhtml\System\Config\ColorPickerField</frontend_model>
                </field>
                <field id="message_text_color" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Message Bubble Text Color</label>
                    <comment>Text color inside the assistant's chat bubbles. See Message Bubble Background Color above for how this pairs automatically when only one of the two is set.</comment>
                    <frontend_model>Aavirbhava\AiShoppingAssistant\Block\Adminhtml\System\Config\ColorPickerField</frontend_model>
                </field>
            </group>

            <group id="llm" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Primary LLM</label>
                <field id="provider" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <comment>Per-provider pricing for the cost cap is managed on Marketing > AI Shopping Assistant > Provider Cost Pricing, not here.</comment>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\Provider</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <comment>Stored using Magento encrypted configuration.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                    <comment>For Local / Ollama, set Base URL below first, then use the "Fetch Ollama Models" button to pick from the models actually pulled on that server.</comment>
                    <frontend_model>Aavirbhava\AiShoppingAssistant\Block\Adminhtml\System\Config\OllamaModelField</frontend_model>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                    <comment>Leave empty for the selected provider's default API endpoint. For Local / Ollama, e.g. http://localhost:11434/v1.</comment>
                </field>
                <field id="timeout_seconds" translate="label" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_output_tokens" translate="label" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Output Tokens</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="fallback" translate="label" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Fallback LLM</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Fallback</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="provider" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <comment>Per-provider pricing for the cost cap is managed on Marketing > AI Shopping Assistant > Provider Cost Pricing, not here.</comment>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\Provider</source_model>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                    <comment>For Local / Ollama, set Base URL below first, then use the "Fetch Ollama Models" button to pick from the models actually pulled on that server.</comment>
                    <frontend_model>Aavirbhava\AiShoppingAssistant\Block\Adminhtml\System\Config\OllamaModelField</frontend_model>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                    <comment>For Local / Ollama, e.g. http://localhost:11434/v1.</comment>
                </field>
                <field id="timeout_seconds" translate="label" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="failure_threshold" translate="label" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Circuit-Breaker Failure Threshold</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="cooldown_seconds" translate="label" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Circuit-Breaker Cooldown (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="embedding" translate="label" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Embeddings</label>
                <field id="provider" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\EmbeddingProvider</source_model>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                    <comment>Required for Local OpenAI-Compatible. Leave empty for OpenAI or Voyage AI; a custom endpoint is rejected for those providers.</comment>
                </field>
                <field id="dimensions" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Embedding Dimensions</label>
                    <comment>Changing dimensions requires a full assistant-index rebuild.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="retrieval" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Retrieval</label>
                <field id="keyword_candidates" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Keyword Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="vector_candidates" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Vector Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="merged_candidates" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merged Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="final_products" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Final Products</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="reranker_enabled" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Reranker</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="rating_signal_weight" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Rating Signal Weight</label>
                    <comment>How much a product's Bayesian-weighted rating nudges ranking order, from 0 (no effect) to 1. Default 0.1 is deliberately conservative — a well-matching low-rated product should still generally outrank a well-rated but irrelevant one.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
            </group>

            <group id="guardrails" translate="label" type="text" sortOrder="60"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Guardrails</label>
                <field id="max_input_characters" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Input Characters</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="max_tool_calls" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Tool Calls per Turn</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="cart_mutations_enabled" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cart Mutations</label>
                    <comment>Gates get_cart, add_to_cart, and remove_from_cart entirely — disabled, none of the three are offered to the assistant.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="require_cart_confirmation" translate="label comment" type="select" sortOrder="35"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Require Confirmation Before Cart Changes</label>
                    <comment>When enabled, add_to_cart/remove_from_cart never execute on their first call for a proposed change — the assistant must relay the proposal to the customer and call again with proof of confirmation.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="block_external_urls" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block External URLs</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="block_code_generation" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block Code Generation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="out_of_scope_message" translate="label" type="textarea" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Out-of-Scope Response</label>
                </field>
                <field id="assistant_unavailable_message" translate="label comment" type="textarea" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Assistant Temporarily Unavailable Response</label>
                    <comment>Shown instead of the Out-of-Scope Response when a chat provider call fails for a reason expected to be momentary (a slow response, a dropped connection, one malformed reply) — the customer can reasonably try again right away.</comment>
                </field>
                <field id="assistant_down_message" translate="label comment" type="textarea" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Assistant Down Response</label>
                    <comment>Shown, and the storefront chat is then stopped for the rest of that visit, when a chat provider call fails for a reason that will keep failing identically (an exhausted quota, an invalid or revoked API key) — retrying immediately cannot help, so the customer is told plainly rather than invited to keep typing.</comment>
                </field>
            </group>

            <group id="capabilities" translate="label" type="text" sortOrder="65"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Assistant Capabilities</label>
                <field id="product_discovery_enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Discovery (search_products)</label>
                    <comment>Lets the assistant search the catalogue on the customer's behalf.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="product_details_enabled" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Questions (get_product_details)</label>
                    <comment>Lets the assistant look up details for one specific SKU.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="comparison_enabled" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Comparison (compare_products)</label>
                    <comment>Lets the assistant compare several SKUs side by side.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="price_checking_enabled" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Price Checking (check_price)</label>
                    <comment>Lets the assistant state live, customer-group-aware prices.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="stock_checking_enabled" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Stock Checking (check_inventory)</label>
                    <comment>Lets the assistant state live stock/salability status.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="policy_search_enabled" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store Content Search (search_store_content)</label>
                    <comment>Lets the assistant search CMS pages, blog posts (if available), and products by keyword — e.g. "do you have a returns policy page."</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="promotion_awareness_enabled" translate="label comment" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Promotion Awareness (get_active_promotions)</label>
                    <comment>Lets the assistant check and mention real, currently-active Catalog Price Rule and Cart Price Rule discounts, both when a customer asks and proactively for products that genuinely have one.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="cost_cap" translate="label" type="text" sortOrder="68"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>LLM Cost Cap</label>
                <field id="amount" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cost Cap Amount</label>
                    <comment>Spend cap for one period, in the store's base currency. Leave at 0 to disable the cap entirely.</comment>
                    <validate>validate-number</validate>
                </field>
                <field id="period" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cap Period</label>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\CapPeriod</source_model>
                </field>
                <field id="warning_threshold_percent" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Warning Threshold (%)</label>
                    <comment>Send a warning notification once usage reaches this percentage of the cap (1-99).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="allow_override" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow Cost Override</label>
                    <comment>If Yes, the chat widget keeps serving customers after the cap is reached (still sends the cap-reached notification). If No, the widget stops rendering entirely once the cap is reached.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="notification_emails" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Notification Email Addresses</label>
                    <comment>Comma-separated list of email addresses notified when the warning threshold or the cap itself is first reached in a period.</comment>
                </field>
            </group>

            <group id="indexing" translate="label" type="text" sortOrder="70"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Indexing</label>
                <field id="batch_size" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Batch Size</label>
                    <comment>Number of products loaded per indexing batch (10-500).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="include_short_description" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Short Description</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="include_long_description" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Long Description</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="aggregate_configurable_variants" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Aggregate Configurable Variants</label>
                    <comment>Not available in this version. Enabling this option is rejected with a configuration error.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="max_attribute_values_per_product" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Attribute Values per Product</label>
                    <comment>Total attribute values kept per product across the configured attributes (1-500).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="index_prefix" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Index Prefix</label>
                    <comment>Prefix for the dedicated assistant index aliases and physical indexes. Lowercase letters, digits, underscore, or hyphen, max 64 characters. Changing this requires a full index rebuild.</comment>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
