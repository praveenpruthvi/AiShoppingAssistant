<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="aavirbhava" translate="label" sortOrder="910">
            <label>Aavirbhava</label>
        </tab>
        <section id="ai_shopping_assistant" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Shopping Assistant</label>
            <tab>aavirbhava</tab>
            <resource>Aavirbhava_AiShoppingAssistant::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Assistant</label>
                    <comment>Disabled by default until providers, retrieval, and guardrails have been tested.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="strict_store_only" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Strict Store-Only Mode</label>
                    <comment>Reject requests unrelated to this store's products, services, and approved content.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="llm" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Primary LLM</label>
                <field id="provider" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\Provider</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <comment>Stored using Magento encrypted configuration.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                    <comment>Leave empty for the selected provider's default API endpoint.</comment>
                </field>
                <field id="timeout_seconds" translate="label" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_output_tokens" translate="label" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Output Tokens</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="fallback" translate="label" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Fallback LLM</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Fallback</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="provider" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\Provider</source_model>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                </field>
                <field id="base_url" translate="label" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                </field>
                <field id="timeout_seconds" translate="label" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="failure_threshold" translate="label" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Circuit-Breaker Failure Threshold</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="cooldown_seconds" translate="label" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Circuit-Breaker Cooldown (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="embedding" translate="label" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Embeddings</label>
                <field id="provider" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <source_model>Aavirbhava\AiShoppingAssistant\Model\Config\Source\EmbeddingProvider</source_model>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL</label>
                    <comment>Required for Local OpenAI-Compatible. Leave empty for OpenAI or Voyage AI; a custom endpoint is rejected for those providers.</comment>
                </field>
                <field id="dimensions" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Embedding Dimensions</label>
                    <comment>Changing dimensions requires a full assistant-index rebuild.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <group id="retrieval" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Retrieval</label>
                <field id="keyword_candidates" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Keyword Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="vector_candidates" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Vector Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="merged_candidates" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merged Candidates</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="final_products" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Final Products</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="reranker_enabled" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Reranker</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="guardrails" translate="label" type="text" sortOrder="60"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Guardrails</label>
                <field id="max_input_characters" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Input Characters</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="max_tool_calls" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Tool Calls per Turn</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="cart_mutations_enabled" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cart Mutations</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="block_external_urls" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block External URLs</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="block_code_generation" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block Code Generation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="out_of_scope_message" translate="label" type="textarea" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Out-of-Scope Response</label>
                </field>
            </group>

            <group id="indexing" translate="label" type="text" sortOrder="70"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Indexing</label>
                <field id="batch_size" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Batch Size</label>
                    <comment>Number of products loaded per indexing batch (10-500).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="searchable_attribute_codes" translate="label comment" type="textarea" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Searchable Attribute Codes</label>
                    <comment>Comma-separated attribute codes normalized into the assistant index. Leave blank to index no custom attributes. Changing this requires a full index rebuild.</comment>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="include_short_description" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Short Description</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="include_long_description" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Long Description</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="aggregate_configurable_variants" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Aggregate Configurable Variants</label>
                    <comment>Not available in this version. Enabling this option is rejected with a configuration error.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
                <field id="max_attribute_values_per_product" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Attribute Values per Product</label>
                    <comment>Total attribute values kept per product across the configured attributes (1-500).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <backend_model>Aavirbhava\AiShoppingAssistant\Model\Config\Backend\InvalidateProductIndex</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
