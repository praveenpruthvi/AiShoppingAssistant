<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Swaps in this module's own subclass (adds the "Indexed for AI
        Assistant" column + mass action) for the native Stores >
        Attributes > Product grid. A `<preference>` on this CONCRETE
        class (not an interface) is valid here because
        Magento\Backend\Block\Widget\Grid\Container::_prepareLayout()
        creates this exact block directly in PHP via createBlock() with
        no stable, addressable layout block name for a `<referenceBlock
        class="...">` override to target instead — see
        Model\Catalog\AttributeGrid\Grid's own docblock for the full
        reasoning.
    -->
    <preference for="Magento\Catalog\Block\Adminhtml\Product\Attribute\Grid"
                type="Aavirbhava\AiShoppingAssistant\Model\Catalog\AttributeGrid\Grid"/>
    <!--
        Supplies the category edit form's own boost field values (Task
        33, view/adminhtml/ui_component/category_form.xml) into
        Magento\Catalog\Model\Category\DataProvider::getData() — the
        real, core-precedented extension point for this concrete class
        (Magento_CatalogUrlRewrite plugs the exact same class, in this
        exact same way, for its own url_key field). See
        CategoryBoostDataProviderPlugin's own docblock for why this
        differs from the product form's usual Modifier-pool technique.
    -->
    <type name="Magento\Catalog\Model\Category\DataProvider">
        <plugin name="aavirbhava_category_boost_data_provider"
                type="Aavirbhava\AiShoppingAssistant\Plugin\Catalog\DataProvider\CategoryBoostDataProviderPlugin"/>
    </type>
</config>
