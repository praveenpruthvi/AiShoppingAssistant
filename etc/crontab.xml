<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="aavirbhava_ai_incremental_work_recovery"
             instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Queue\IncrementalWorkRecoveryCron"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="aavirbhava_ai_incremental_product_reconciliation"
             instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Reconciliation\IncrementalProductReconciliationCron"
             method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
    </group>
</config>
