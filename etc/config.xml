<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ai_shopping_assistant>
            <general>
                <enabled>0</enabled>
                <strict_store_only>1</strict_store_only>
                <max_conversation_messages>40</max_conversation_messages>
                <token_optimization_enabled>0</token_optimization_enabled>
            </general>
            <llm>
                <provider></provider>
                <model></model>
                <base_url></base_url>
                <timeout_seconds>20</timeout_seconds>
                <max_output_tokens>1200</max_output_tokens>
            </llm>
            <fallback>
                <enabled>0</enabled>
                <provider></provider>
                <model></model>
                <base_url></base_url>
                <timeout_seconds>30</timeout_seconds>
                <failure_threshold>3</failure_threshold>
                <cooldown_seconds>60</cooldown_seconds>
            </fallback>
            <embedding>
                <provider>local_openai_compatible</provider>
                <model></model>
                <base_url></base_url>
                <dimensions>1024</dimensions>
            </embedding>
            <retrieval>
                <keyword_candidates>50</keyword_candidates>
                <vector_candidates>50</vector_candidates>
                <merged_candidates>30</merged_candidates>
                <final_products>8</final_products>
                <reranker_enabled>0</reranker_enabled>
                <rating_signal_weight>0.1</rating_signal_weight>
            </retrieval>
            <guardrails>
                <max_input_characters>1000</max_input_characters>
                <max_tool_calls>4</max_tool_calls>
                <cart_mutations_enabled>0</cart_mutations_enabled>
                <require_cart_confirmation>1</require_cart_confirmation>
                <block_external_urls>1</block_external_urls>
                <block_code_generation>1</block_code_generation>
                <out_of_scope_message>I can help you search, compare, and learn about products and services available on this store. What are you looking for?</out_of_scope_message>
                <assistant_unavailable_message>I'm having trouble answering right now. Please try again in a moment.</assistant_unavailable_message>
                <assistant_down_message>Our shopping assistant is temporarily unavailable due to a technical issue. Please try again later, or contact us directly for help.</assistant_down_message>
            </guardrails>
            <capabilities>
                <product_discovery_enabled>1</product_discovery_enabled>
                <product_details_enabled>1</product_details_enabled>
                <comparison_enabled>1</comparison_enabled>
                <price_checking_enabled>1</price_checking_enabled>
                <stock_checking_enabled>1</stock_checking_enabled>
                <policy_search_enabled>1</policy_search_enabled>
                <promotion_awareness_enabled>1</promotion_awareness_enabled>
            </capabilities>
            <cost_cap>
                <amount>0</amount>
                <period>daily</period>
                <warning_threshold_percent>80</warning_threshold_percent>
                <allow_override>0</allow_override>
                <notification_emails></notification_emails>
            </cost_cap>
            <indexing>
                <batch_size>100</batch_size>
                <include_short_description>1</include_short_description>
                <include_long_description>1</include_long_description>
                <aggregate_configurable_variants>0</aggregate_configurable_variants>
                <max_attribute_values_per_product>100</max_attribute_values_per_product>
                <index_prefix>aavirbhava_ai_product_rag</index_prefix>
            </indexing>
        </ai_shopping_assistant>
    </default>
</config>
