<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ai_shopping_assistant>
            <general>
                <enabled>0</enabled>
                <strict_store_only>1</strict_store_only>
            </general>
            <llm>
                <provider>openai</provider>
                <model>gpt-5.6-terra</model>
                <base_url></base_url>
                <timeout_seconds>20</timeout_seconds>
                <max_output_tokens>1200</max_output_tokens>
            </llm>
            <fallback>
                <enabled>0</enabled>
                <provider>openai_compatible</provider>
                <model>qwen3:14b</model>
                <base_url>http://127.0.0.1:11434/v1</base_url>
                <timeout_seconds>30</timeout_seconds>
                <failure_threshold>3</failure_threshold>
                <cooldown_seconds>60</cooldown_seconds>
            </fallback>
            <embedding>
                <provider>openai_compatible</provider>
                <model>bge-m3</model>
                <base_url>http://127.0.0.1:11434/v1</base_url>
                <dimensions>1024</dimensions>
            </embedding>
            <retrieval>
                <keyword_candidates>50</keyword_candidates>
                <vector_candidates>50</vector_candidates>
                <merged_candidates>30</merged_candidates>
                <final_products>8</final_products>
                <reranker_enabled>0</reranker_enabled>
            </retrieval>
            <guardrails>
                <max_input_characters>1000</max_input_characters>
                <max_tool_calls>4</max_tool_calls>
                <cart_mutations_enabled>0</cart_mutations_enabled>
                <block_external_urls>1</block_external_urls>
                <block_code_generation>1</block_code_generation>
                <out_of_scope_message>I can help you search, compare, and learn about products and services available on this store. What are you looking for?</out_of_scope_message>
            </guardrails>
        </ai_shopping_assistant>
    </default>
</config>
