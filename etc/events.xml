<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_commit_after">
        <observer name="aavirbhava_ai_incremental_product_save_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\ProductChangeCommitObserver"/>
    </event>
    <event name="catalog_product_delete_commit_after">
        <observer name="aavirbhava_ai_incremental_product_delete_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\ProductChangeCommitObserver"/>
    </event>
    <event name="catalog_category_save_commit_after">
        <observer name="aavirbhava_ai_incremental_category_save_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\CategoryChangeCommitObserver"/>
    </event>
    <event name="catalog_category_delete_commit_after">
        <observer name="aavirbhava_ai_incremental_category_delete_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\CategoryChangeCommitObserver"/>
    </event>
    <event name="catalog_entity_attribute_save_commit_after">
        <observer name="aavirbhava_ai_incremental_catalog_attribute_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\IndirectCatalogueChangeObserver"/>
    </event>
    <event name="eav_entity_attribute_save_commit_after">
        <observer name="aavirbhava_ai_incremental_eav_attribute_capture"
                  instance="Aavirbhava\AiShoppingAssistant\Model\Indexing\Capture\IndirectCatalogueChangeObserver"/>
    </event>
</config>
