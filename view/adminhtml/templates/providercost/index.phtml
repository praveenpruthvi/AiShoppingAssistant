?>
<div class="admin__fieldset-wrapper aavirbhava-provider-cost">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $block->escapeHtml(__('Provider Cost Pricing')) ?></strong>
    </div>
    <div class="admin__field-note" style="padding: 0 2.4rem 1.6rem;">
        <span><?= $block->escapeHtml(__(
            'Set the real per-1,000-token price for each LLM provider, used only to compute spend '
            . 'against the LLM Usage Cost Cap. A provider with no pricing set here is tracked as $0.00 '
            . '— correct for a free/self-hosted provider, but worth confirming for a paid one.'
        )) ?></span>
    </div>

    <?php foreach ($notices as $notice): ?>
        <div class="message message-warning warning" style="margin: 0 2.4rem 1.6rem;">
            <?= $block->escapeHtml($notice) ?>
        </div>
    <?php endforeach; ?>

    <form method="post" action="<?= $block->escapeUrl($block->getSaveUrl()) ?>">
        <input name="form_key" type="hidden" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>"/>

        <fieldset class="admin__fieldset" style="padding: 0 2.4rem;">
            <div class="admin__field _required">
                <label class="admin__field-label" for="aavirbhava-provider-cost-provider">
                    <span><?= $block->escapeHtml(__('Provider')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="aavirbhava-provider-cost-provider" name="provider" class="admin__control-select" required="required">
                        <option value=""><?= $block->escapeHtml(__('-- Select a Provider --')) ?></option>
                        <?php foreach ($providers as $option): ?>
                            <option value="<?= $block->escapeHtmlAttr($option['value']) ?>"
