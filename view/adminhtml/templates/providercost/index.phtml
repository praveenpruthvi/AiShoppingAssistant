                        </td>
                        <td class="data-grid-td"><?= $block->escapeHtml((string) $row['input']) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml((string) $row['output']) ?></td>
                        <td class="data-grid-td">
                            <a href="<?= $block->escapeUrl($block->getEditUrl($row['identifier'])) ?>">
                                <?= $block->escapeHtml(__('Edit')) ?>
                            </a>
