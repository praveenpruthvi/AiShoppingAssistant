    <div class="admin__fieldset-wrapper-title" style="margin-top: 1.6rem;">
        <strong><?= $block->escapeHtml(__('Currently Configured Providers')) ?></strong>
    </div>

    <?php if ($configured === []): ?>
        <div class="message message-notice notice" style="margin: 0 2.4rem 1.6rem;">
            <?= $block->escapeHtml(__('No provider has pricing configured yet.')) ?>
        </div>
    <?php else: ?>
        <table class="data-grid" style="margin: 0 2.4rem 1.6rem; width: calc(100% - 4.8rem);">
            <thead>
                <tr class="data-grid-tr">
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Provider')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Price per 1K Input Tokens')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Price per 1K Output Tokens')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Action')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($configured as $row): ?>
                    <tr class="data-grid-tr">
                        <td class="data-grid-td"><?= $block->escapeHtml($row['label']) ?>
