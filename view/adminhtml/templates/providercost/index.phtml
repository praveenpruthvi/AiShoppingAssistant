                                <?= $block->escapeHtml($option['label']) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>
            <div class="admin__field _required">
                <label class="admin__field-label" for="aavirbhava-provider-cost-input">
                    <span><?= $block->escapeHtml(__('Price per 1,000 Input Tokens')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input type="text" id="aavirbhava-provider-cost-input" name="price_per_1k_input_tokens"
                           class="admin__control-text validate-number validate-zero-or-greater"
                           value="<?= $block->escapeHtmlAttr((string) $block->getEditingInputPrice()) ?>"/>
                </div>
            </div>
            <div class="admin__field _required">
                <label class="admin__field-label" for="aavirbhava-provider-cost-output">
                    <span><?= $block->escapeHtml(__('Price per 1,000 Output Tokens')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input type="text" id="aavirbhava-provider-cost-output" name="price_per_1k_output_tokens"
                           class="admin__control-text validate-number validate-zero-or-greater"
                           value="<?= $block->escapeHtmlAttr((string) $block->getEditingOutputPrice()) ?>"/>
                </div>
            </div>
            <div class="admin__field" style="padding-top: 0.8rem;">
                <button type="submit" class="action-primary">
                    <span><?= $block->escapeHtml(__('Save Pricing')) ?></span>
                </button>
            </div>
        </fieldset>
