<?php
/**
 * @var \Aavirbhava\AiShoppingAssistant\Block\Adminhtml\AttributeSelection\Index $block
 */
$attributes = $block->getEligibleAttributes();

/**
 * Visual-only grouping (Task 51): a real attribute-set/group membership
 * grouping was considered and deliberately rejected — this screen lists
 * ELIGIBLE attributes across the whole catalog, and a single catalog
 * attribute can belong to zero, one, or many attribute sets/groups with
 * no canonical "the" group to key off of; resolving one would mean new
 * EAV lookup logic (plus an "ungrouped" fallback for attributes not on
 * the default set), not a presentation-only change. Grouping by the
 * first letter of the already-displayed, already-alphabetically-sorted
 * label needs no new data from the block at all (same $attributes array,
 * same 'code'/'label'/'isIndexed' shape) and, on this store's own real
 * attribute set, happens to cluster genuinely related attributes anyway
 * (e.g. this catalog's "Style Bags"/"Style Bottom"/"Style General" all
 * land under "S").
 */
$groups = [];
foreach ($attributes as $attribute) {
    $letter = strtoupper(substr(trim((string) $attribute['label']), 0, 1) ?: '#');
    $groups[$letter][] = $attribute;
}
?>
<div class="admin__fieldset-wrapper aavirbhava-attribute-selection">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $block->escapeHtml(__('Attribute Indexing Selection')) ?></strong>
    </div>
    <div class="admin__field-note aavirbhava-attribute-selection-intro">
        <span><?= $block->escapeHtml(__(
            'Select which product attributes feed the AI Shopping Assistant\'s search index and the '
            . 'facts it can state about a product. Only real, merchant-defined attributes are listed '
            . '(system/internal attributes are never shown here). Saving here or via the "Indexed for '
            . 'AI Assistant" column on Stores > Attributes > Product updates the same selection — either '
            . 'always reflects the other immediately. A full reindex is required for a changed selection '
            . 'to take effect in search results.'
        )) ?></span>
    </div>

    <?php if ($attributes === []): ?>
        <div class="message message-notice notice aavirbhava-attribute-selection-empty">
            <?= $block->escapeHtml(__('No eligible product attributes were found.')) ?>
        </div>
    <?php else: ?>
        <form method="post" action="<?= $block->escapeUrl($block->getSaveUrl()) ?>">
            <input name="form_key" type="hidden" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>"/>
            <input type="hidden" name="all_codes" value="<?= $block->escapeHtmlAttr($block->getAllEligibleCodesCsv()) ?>"/>

            <fieldset class="admin__fieldset aavirbhava-attribute-selection-fieldset">
                <?php foreach ($groups as $letter => $groupAttributes): ?>
                    <div class="aavirbhava-attribute-group">
                        <div class="aavirbhava-attribute-group-heading">
                            <?= $block->escapeHtml($letter) ?>
                        </div>
                        <div class="admin__field aavirbhava-attribute-selection-grid">
                            <?php foreach ($groupAttributes as $attribute): ?>
                                <?php $inputId = 'aavirbhava-attr-' . $block->escapeHtmlAttr($attribute['code']); ?>
                                <div class="admin__field-option aavirbhava-attribute-option">
                                    <input type="checkbox" id="<?= $inputId ?>" name="selected_codes[]"
                                           value="<?= $block->escapeHtmlAttr($attribute['code']) ?>"
                                           class="admin__control-checkbox"
                                        <?= $attribute['isIndexed'] ? 'checked="checked"' : '' ?>/>
                                    <label class="admin__field-label" for="<?= $inputId ?>">
                                        <?= $block->escapeHtml($attribute['label']) ?>
                                        <span class="aavirbhava-attribute-code"><?= $block->escapeHtml($attribute['code']) ?></span>
                                    </label>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endforeach; ?>

                <div class="admin__field aavirbhava-attribute-selection-actions">
                    <button type="submit" class="action-primary">
                        <span><?= $block->escapeHtml(__('Save Selection')) ?></span>
                    </button>
                </div>
            </fieldset>
        </form>
    <?php endif; ?>
</div>

