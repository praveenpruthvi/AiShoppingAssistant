<script>
require(['jquery'], function ($) {
    'use strict';
    $('#aavirbhava-playground-test-connection').on('click', function () {
        var $button = $(this);
        var $resultEl = $('#aavirbhava-playground-test-connection-result');
        $button.prop('disabled', true);
        $resultEl.text('<?= /* @noEscape */ $block->escapeJs(__('Testing...')) ?>');

        $.ajax({
            url: '<?= /* @noEscape */ $block->escapeUrl($block->getTestConnectionUrl()) ?>',
            type: 'POST',
            dataType: 'json',
            data: {form_key: '<?= /* @noEscape */ $block->escapeJs($block->getFormKey()) ?>'}
        }).done(function (response) {
            if (response.successful) {
                $resultEl.text('✓ ' + response.message);
            } else {
                $resultEl.text('✗ ' + response.message);
            }
        }).fail(function () {
            $resultEl.text('<?= /* @noEscape */ $block->escapeJs(__('Request failed.')) ?>');
        }).always(function () {
            $button.prop('disabled', false);
        });
    });
});
</script>
