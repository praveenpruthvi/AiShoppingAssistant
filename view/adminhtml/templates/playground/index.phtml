/*
 * Real root cause (found by reading _checkbox-radio.less directly): the
 * checkbox's visible glyph is a floated ::before on its <label>, and
 * Magento's own gap between glyph and text only exists for a label
 * carrying the .admin__field-label class specifically (padding-left:
 * 1.6rem + 1rem, with the glyph pulled back via a matching negative
 * margin) — this template's checkbox label is a plain <label>, which
 * never picked up that rule, so the glyph and text rendered with no
 * gap. Re-applied the identical padding/negative-margin pair (Magento's
 * own @control-checkbox-radio__size/@field-label__indent values, 1.6rem/
 * 1rem) to the plain label instead of only adding padding to the label
 * (which alone cannot separate a floated ::before from adjacent text).
 */
.aavirbhava-playground .admin__control-checkbox + label { padding-left: 2.6rem; }
.aavirbhava-playground .admin__control-checkbox + label:before { margin: 1px 1rem 0 -2.6rem; }
