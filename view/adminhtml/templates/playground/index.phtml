/**
 * Lightweight, dependency-free JSON syntax highlighter — no new JS
 * library, matching this module's existing "vanilla JS" convention for
 * the storefront widget (chat-widget-core.js). Tokenizes each
 * [data-aavirbhava-json] element's own textContent (never innerHTML of
 * untrusted content) and rebuilds it from document.createTextNode()/
 * document.createElement('span') calls only — every span's text is set
 * via .textContent, which the browser always treats as literal text, so
 * this can never inject markup regardless of what a real LLM tool result
 * or product name happens to contain.
 */
(function () {
    'use strict';

    var TOKEN_PATTERN = /("(?:\\.|[^"\\])*"(?:\s*:)?|\btrue\b|\bfalse\b|\bnull\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|[{}\[\],:])/g;

    function classify(token) {
        if (token.charAt(0) === '"') {
            return /:\s*$/.test(token) ? 'aavirbhava-json-key' : 'aavirbhava-json-string';
        }
        if (token === 'true' || token === 'false') {
            return 'aavirbhava-json-boolean';
        }
        if (token === 'null') {
            return 'aavirbhava-json-null';
        }
        if (/^[{}\[\],:]$/.test(token)) {
            return 'aavirbhava-json-punctuation';
        }
        return 'aavirbhava-json-number';
    }

    function highlight(element) {
        var text = element.textContent;
        var fragment = document.createDocumentFragment();
        var lastIndex = 0;
        var match;

        TOKEN_PATTERN.lastIndex = 0;
        while ((match = TOKEN_PATTERN.exec(text)) !== null) {
            if (match.index > lastIndex) {
                fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
            }

            var span = document.createElement('span');
            span.className = classify(match[0]);
            span.textContent = match[0];
            fragment.appendChild(span);

            lastIndex = TOKEN_PATTERN.lastIndex;
        }

        if (lastIndex < text.length) {
            fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
        }

        element.textContent = '';
        element.appendChild(fragment);
    }

    var blocks = document.querySelectorAll('[data-aavirbhava-json]');
    for (var i = 0; i < blocks.length; i++) {
        highlight(blocks[i]);
    }
}());
</script>
